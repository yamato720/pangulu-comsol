# Only production source, entrypoints and client documentation are tracked.
/*
!/.gitignore
!/README.md
!/pc.py
!/start.sh
!/update.sh
!/src/

!/config/
/config/*
!/config/distribution.json
!/config/README.md

!/licence/
/licence/*
!/licence/README.txt

!/docs/
/docs/*
!/docs/usage.md
!/docs/architecture.md
!/docs/customer-README.txt

# Generated compiler/interpreter outputs are never production source.
__pycache__/
*.py[cod]
*.class
*.o
*.so
*.so.*
*.jar
