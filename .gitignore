# Only production source, entrypoints and client documentation are tracked.
/*
!/.gitignore
!/README.md
!/pangu-comsol
!/start.sh
!/pyproject.toml
!/setup.py
!/MANIFEST.in
!/src/
!/dev/

!/config/
/config/*
!/config/distribution.json
!/config/README.md

!/licence/
/licence/*
!/licence/README.txt

!/docs/
/docs/*
!/docs/usage.md
!/docs/architecture.md
!/docs/customer-README.txt

# Generated compiler/interpreter outputs are never production source.
__pycache__/
*.py[cod]
*.class
*.o
*.so
*.so.*
*.jar
*.egg-info/

# Developer source is versioned on develop; generated environments stay local.
/dev/**/build/
/dev/**/dist/
/dev/**/runs/
/dev/**/datasets/
/dev/**/.venv/
*.license.key
.env
.env.*
